{
  "name": "@ai-designer/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Background job worker (BullMQ consumers from I02/I03)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "devDependencies": {
    "@ai-designer/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@ai-designer/contracts": "workspace:*",
    "@ai-designer/db": "workspace:*",
    "@ai-designer/logger": "workspace:*",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
