{
  "name": "@ai-designer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS modular-monolith API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "storage:init": "tsx src/scripts/init-storage.ts",
    "clean": "rimraf dist coverage .turbo",
    "dev:ping": "tsx src/scripts/enqueue-ping.ts",
    "openapi:generate": "tsx src/scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@ai-designer/contracts": "workspace:*",
    "@ai-designer/db": "workspace:*",
    "@ai-designer/garment-model": "workspace:*",
    "@ai-designer/logger": "workspace:*",
    "@ai-designer/media": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "better-auth": "1.7.7",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.16",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-designer/config": "workspace:*",
    "@ai-designer/test-utils": "workspace:*",
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "rimraf": "6.1.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
