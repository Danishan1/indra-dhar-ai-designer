    "/v1/health/ready": {
      "get": {
        "operationId": "Health_readiness",
        "summary": "Readiness probe (503 when a dependency is down)",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "down"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "down"
                          ]
                        },
                        "objectStorage": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "down"
                          ]
                        }
                      },
                      "required": [
                        "database",
                        "redis",
                        "objectStorage"
                      ],
                      "additionalProperties": false
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "checks",
                    "time"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Error: VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
