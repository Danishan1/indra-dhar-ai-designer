{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Designer API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "tags": [
    {
      "name": "health"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "Health_liveness",
        "summary": "Liveness probe",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    },
                    "service": {
                      "type": "string",
                      "const": "api"
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version",
                    "time"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Error: VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Error: INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "Health_readiness",
        "summary": "Readiness probe (503 when a dependency is down)",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "down"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "down"
                          ]
                        },
                        "objectStorage": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "down"
                          ]
                        }
                      },
                      "required": [
                        "database",
                        "redis",
                        "objectStorage"
                      ],
                      "additionalProperties": false
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "checks",
                    "time"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Error: VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Error: INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Error: DEPENDENCY_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "PERMISSION_DENIED",
                  "NOT_FOUND",
                  "CONFLICT",
                  "INVALID_STATE_TRANSITION",
                  "CONCURRENT_MODIFICATION",
                  "IDEMPOTENCY_CONFLICT",
                  "VALIDATION_BLOCKED",
                  "DEPENDENCY_UNAVAILABLE",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "UNSUPPORTED_CAPABILITY",
                  "RETENTION_POLICY_BLOCKED",
                  "REVISION_NOT_FOUND",
                  "REVISION_NOT_APPROVED",
                  "PAYLOAD_TOO_LARGE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
