# Copy to .env and adjust. Never commit .env.
# Defaults match infra/compose/docker-compose.dev.yml. Each iteration appends what it introduces
# (docs/plan/07-environment-setup.md §3).

NODE_ENV=development
APP_VERSION=0.0.0

# ---- Ports & URLs
WEB_PORT=3000
API_PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# The browser calls the API same-origin (/v1/* is proxied by the web app to API_BASE_URL).

# ---- Logging (see logs/README.md). Console: LOG_PRETTY=true for human-readable output, JSON otherwise.
LOG_LEVEL=info
LOG_PRETTY=true
# Write rotating JSON log files to logs/<service>/ (default: true in development, false otherwise)
LOG_TO_FILE=true
# LOG_DIR=logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_RETENTION=14
# Browser error reporting endpoint (web → logs/web/client.*.log); default: development only
CLIENT_LOGS_ENABLED=true

# ---- PostgreSQL (compose service "postgres")
DATABASE_URL=postgresql://aid:aid_dev_password@localhost:5432/ai_designer
# Using a PostgreSQL installed on this machine instead of the container?
#   INFRA_LOCAL_POSTGRES=true
#   DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ai_designer
#   AID_IT_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ai_designer_test   (integration tests)
INFRA_LOCAL_POSTGRES=false

# ---- Redis (compose service "redis")
REDIS_URL=redis://localhost:6379

# ---- S3-compatible object storage (compose service "objectstore", SeaweedFS — ADR-021)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=aid-dev-access-key
S3_SECRET_ACCESS_KEY=aid-dev-secret-key-change-me
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=aid-assets-original
S3_BUCKET_DERIVED=aid-assets-derived
S3_BUCKET_EXPORTS=aid-exports
# Browser-facing object-store URL for signed download links (defaults to S3_ENDPOINT)
# S3_PUBLIC_ENDPOINT=http://localhost:8333

# ---- Assets (I09): upload limits; malware scanner (none until ClamAV, I47)
ASSET_MAX_IMAGE_MB=25
ASSET_MAX_SVG_MB=2
ASSET_MAX_DOCUMENT_MB=50
ASSET_MAX_PIXELS=50000000
ASSET_URL_TTL_SECONDS=300
ASSET_SCANNER=none

# ---- Email (compose service "mailpit"; UI http://localhost:8025)
SMTP_URL=smtp://localhost:1025

# ---- Authentication (I05, Better Auth — ADR-006)
# Signs session cookies; generate your own: openssl rand -base64 32 (never commit real values)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Session cookie __Host-aid_session needs Secure (fine on http://localhost). false only for plain-http LAN testing.
AUTH_COOKIE_SECURE=true
SESSION_IDLE_TIMEOUT_MIN=10080
SESSION_ABSOLUTE_TIMEOUT_H=720
SESSION_TOUCH_INTERVAL_MIN=60
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
# Encrypts secrets at rest (TOTP secrets; provider keys later) — ADR-007. 32 random bytes, base64:
#   openssl rand -base64 32      (required in production; dev falls back to a key derived from BETTER_AUTH_SECRET)
# SECRETS_MASTER_KEY=
MFA_ISSUER="AI Designer"
MAIL_FROM="AI Designer <no-reply@ai-designer.local>"

# ---- API platform (I03)
IDEMPOTENCY_TTL_HOURS=24
# /v1/openapi.json and /v1/_dev/* example routes; default on outside production
# API_DEV_ROUTES=true

# ---- Worker
WORKER_CONCURRENCY_SYSTEM=2
WORKER_CONCURRENCY_EVENTS=4
WORKER_CONCURRENCY_JOBS=2
# WORKER_ID defaults to <hostname>-<pid>
# Outbox dispatcher (ADR-005)
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
# Durable-job recovery sweeper (ADR-023)
JOB_SWEEP_INTERVAL_MS=60000
JOB_REQUEUE_AFTER_MS=60000
JOB_STALE_AFTER_MS=300000

# ---- Disable Next.js anonymous telemetry
NEXT_TELEMETRY_DISABLED=1

# ---- Integration tests use the isolated compose `test` profile (pnpm infra:test:up) automatically.
# Integration tests also use Mailpit on 51025/58025 (test profile).
# Override individual values with AID_IT_<KEY> (here or in the shell), e.g. AID_IT_DATABASE_URL=...
