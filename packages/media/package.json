{
  "name": "@ai-designer/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Files: S3-compatible object storage client, storage keys, magic-byte sniffing, SVG sanitizing, image derivatives (sharp), scanner port",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@ai-designer/contracts": "workspace:*",
    "@ai-designer/db": "workspace:*",
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "dompurify": "3.4.16",
    "jsdom": "29.1.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@ai-designer/config": "workspace:*",
    "@types/jsdom": "28.0.3",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
