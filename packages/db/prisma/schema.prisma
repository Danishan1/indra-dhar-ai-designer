// AI Designer — Prisma schema (PostgreSQL).
//
// Conventions (docs/plan/02-conventions.md §7, 03-domain-model.md):
// - Models are PascalCase singular; tables snake_case plural via @@map; columns snake_case via @map.
// - Primary keys: uuid (UUIDv7 generated in the application, ADR-001).
// - Timestamps: timestamptz (@db.Timestamptz(6)), UTC.
// - Tenant tables carry organization_id (uuid, not null, indexed).
// - Immutable records (revisions, ledgers, audit) are protected by DB triggers in raw-SQL migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Records which plan iteration/schema baseline the database is at (informational).
model SchemaMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("schema_meta")
}

// ───────────────────────────── Platform primitives (I03) ─────────────────────────────

/// Per-scope counters for human-readable display ids (ADR-001), e.g. PRJ-000123.
/// scope_key = organization id, or "platform" for global sequences.
model IdSequence {
  scopeKey  String   @map("scope_key")
  prefix    String
  nextValue BigInt   @default(0) @map("next_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([scopeKey, prefix])
  @@map("id_sequences")
}

/// Append-only audit trail (SPEC-009 §15). UPDATE/DELETE are blocked by a trigger.
model AuditEvent {
  id             String   @id @db.Uuid
  eventType      String   @map("event_type")
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  organizationId String?  @map("organization_id") @db.Uuid
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  action         String
  outcome        String
  reasonCode     String?  @map("reason_code")
  requestId      String?  @map("request_id")
  correlationId  String?  @map("correlation_id")
  policyVersion  String?  @map("policy_version")
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([organizationId, occurredAt])
  @@index([organizationId, actorId, occurredAt], map: "audit_events_org_actor_idx")
  @@index([resourceType, resourceId])
  @@index([eventType, occurredAt])
  @@map("audit_events")
}

/// Transactional outbox (ADR-005): written in the same transaction as the state change.
model OutboxEvent {
  id             String    @id @db.Uuid
  type           String
  schemaVersion  Int       @map("schema_version")
  payload        Json
  organizationId String?   @map("organization_id") @db.Uuid
  actorType      String    @map("actor_type")
  actorId        String?   @map("actor_id")
  correlationId  String?   @map("correlation_id")
  causationId    String?   @map("causation_id")
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

/// Consumer de-duplication: one row per (consumer, event) that has been processed.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

/// HTTP Idempotency-Key records (docs/plan/01-architecture.md §4.4).
model IdempotencyKey {
  id             String   @id @db.Uuid
  principalKey   String   @map("principal_key")
  route          String
  key            String
  requestHash    String   @map("request_hash")
  status         String
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([principalKey, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Generic durable job record (ADR-023). BullMQ messages carry only the job id.
model Job {
  id             String       @id @db.Uuid
  displayId      String       @map("display_id")
  kind           String
  status         String
  organizationId String?      @map("organization_id") @db.Uuid
  payload        Json         @default("{}")
  result         Json?
  failure        Json?
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3) @map("max_attempts")
  correlationId  String?      @map("correlation_id")
  createdBy      String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  heartbeatAt    DateTime?    @map("heartbeat_at") @db.Timestamptz(6)
  attemptsLog    JobAttempt[]

  @@unique([organizationId, displayId])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("jobs")
}

model JobAttempt {
  id            String    @id @db.Uuid
  jobId         String    @map("job_id") @db.Uuid
  attemptNumber Int       @map("attempt_number")
  status        String
  workerId      String?   @map("worker_id")
  error         Json?
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@map("job_attempts")
}

// ---------------------------------------------------------------- identity (I05, ADR-006 Better Auth)
// Table/field names follow our conventions; Better Auth's logical models are mapped onto them in
// apps/api/src/modules/identity/auth.ts (user → User, session → Session, account →
// IdentityCredential, verification → VerificationToken).

model User {
  id               String               @id @db.Uuid
  email            String               @unique
  displayName      String               @map("display_name")
  emailVerified    Boolean              @default(false) @map("email_verified")
  image            String?
  /// pending_verification | active | suspended | locked | deletion_pending | deleted_or_anonymized (FR-SEC-004)
  status           String               @default("pending_verification")
  emailVerifiedAt  DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt      DateTime?            @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount Int                  @default(0) @map("failed_login_count")
  lockedUntil      DateTime?            @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions         Session[]
  credentials      IdentityCredential[]
  mfaFactors       MfaFactor[]
  recoveryCodes    MfaRecoveryCode[]

  @@index([status])
  @@map("users")
}

/// Browser session. `token` is the opaque session id; the cookie carries it HMAC-signed with
/// BETTER_AUTH_SECRET, so a leaked table alone cannot be replayed (ADR-006).
model Session {
  id                String    @id @db.Uuid
  token             String    @unique
  userId            String    @map("user_id") @db.Uuid
  /// Idle expiry (sliding, refreshed at most once per SESSION_TOUCH_INTERVAL).
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Absolute expiry; never extended.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  /// password | mfa_pending (password ok, second factor outstanding) | mfa_verified (I08)
  authAssurance     String    @default("password") @map("auth_assurance")
  /// When this session last completed a second factor.
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  /// Last re-verification (login, MFA or step-up); step-up actions need it to be recent (FR-SEC-040).
  stepUpAt          DateTime? @map("step_up_at") @db.Timestamptz(6)
  /// HMAC of the client IP (never the raw address).
  ipAddress         String?   @map("ip_hash")
  userAgent         String?   @map("user_agent_summary")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Login credentials. providerId 'credential' = password (argon2id hash in `password`); later
/// 'totp', 'passkey', OIDC providers (I08, backlog).
model IdentityCredential {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  password              String?   @map("password_hash")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("identity_credentials")
}

/// Second factors (I08). TOTP secrets are envelope-encrypted with the secrets master key (ADR-007);
/// `lastUsedStep` blocks replay of a code within its validity window.
model MfaFactor {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// totp (passkeys later)
  type             String
  /// pending (setup started) | active
  status           String
  secretCiphertext String    @map("secret_ciphertext")
  lastUsedStep     BigInt?   @map("last_used_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factors")
}

/// Single-use recovery codes, stored only as keyed hashes (FR-SEC-037).
model MfaRecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Single-use tokens (email verification, password reset). `identifier` is stored as a SHA-256
/// hash of "<purpose>:<token>" — the raw token exists only in the email (FR-SEC-012/015).
model VerificationToken {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([value])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------- organizations (I06, ADR-017)

/// Tenant boundary (FR-SEC-060/061). display_id ORG-000123 is platform-unique.
model Organization {
  id               String           @id @db.Uuid
  displayId        String           @unique @map("display_id")
  name             String
  slug             String           @unique
  /// active | suspended | deleted
  status           String           @default("active")
  /// Continuity rule (FR-SEC-079): at least one active owner at all times.
  ownerPolicy      String           @default("at_least_one_owner") @map("owner_policy")
  settings         Json             @default("{}")
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaces       Workspace[]
  memberships      Membership[]
  /// Relations declared so Prisma keeps the FKs (rows owned by the authorization module).
  customRoles      Role[]
  projects         Project[]
  designs          Design[]
  workingCopies    WorkingCopy[]
  designRevisions  DesignRevision[]
  assets           Asset[]
  resourceGrants   ResourceGrant[]
  securityPolicies SecurityPolicy[]
  invitations      Invitation[]

  @@map("organizations")
}

/// Optional sub-scope inside an organization (ADR-017). Schema + default workspace only; UI later.
model Workspace {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  status         String       @default("active")
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("workspaces")
}

/// System roles (placeholder catalog, I06); I07 adds permissions and org-defined roles.
/// Role = named set of permissions (SPEC-009 §11.3). System roles (organization_id NULL) are synced
/// from packages/contracts/src/roles.ts at API start / `pnpm db:seed`; custom roles (organization_id
/// set) arrive later with the same catalog and checks (FR-SEC-092).
model Role {
  id             String           @id @db.Uuid
  key            String
  name           String
  description    String           @default("")
  /// organization | workspace
  scopeType      String           @default("organization") @map("scope_type")
  isSystem       Boolean          @default(true) @map("is_system")
  /// NULL for system roles; the owning organization for custom roles.
  organizationId String?          @map("organization_id") @db.Uuid
  /// Can be given through role assignment (false for Owner: transfer only).
  assignable     Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships    MembershipRole[]
  permissions    RolePermission[]
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("roles")
}

/// Mirror of the permission catalog (packages/contracts/src/permissions.ts) for reporting and
/// referential integrity. Keys are never renamed or reused (FR-SEC-084).
model Permission {
  key          String           @id
  resourceType String           @map("resource_type")
  action       String
  description  String
  isPlatform   Boolean          @default(false) @map("is_platform")
  sensitive    Boolean          @default(false)
  roles        RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Explicit resource-level share (FR-SEC-094…100), evaluated by the PDP after role permissions.
/// Creation endpoints arrive with shareable resources (projects I10, tech packs I43).
model ResourceGrant {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  resourceType   String       @map("resource_type")
  resourceId     String       @map("resource_id") @db.Uuid
  /// user | external (I43)
  recipientType  String       @map("recipient_type")
  recipientId    String       @map("recipient_id") @db.Uuid
  actions        String[]
  grantedBy      String       @map("granted_by") @db.Uuid
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedBy      String?      @map("revoked_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, recipientType, recipientId])
  @@index([resourceType, resourceId])
  @@map("resource_grants")
}

/// Versioned organization security policy (defaults created with the org; used by I08/I28).
model SecurityPolicy {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  version        Int
  config         Json         @default("{}")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, version])
  @@map("security_policies")
}

/// One record per user–organization relationship (FR-SEC-067). Ended memberships are kept for
/// history (FR-SEC-071); re-joining creates a new row. At most one active/suspended row per pair.
model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  /// invited | active | suspended | revoked | expired
  status         String
  invitedBy      String?          @map("invited_by") @db.Uuid
  invitationId   String?          @map("invitation_id") @db.Uuid
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz(6)
  endReason      String?          @map("end_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]

  @@index([userId])
  @@index([organizationId, status])
  @@map("memberships")
}

model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  /// Workspace id for workspace-scoped grants (ADR-017, not used yet); NULL = whole organization.
  scopeId      String?    @map("scope_id") @db.Uuid
  grantedBy    String?    @map("granted_by") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

/// Org-scoped, single-use, expiring invitation (FR-SEC-072…077). Token stored as SHA-256 only.
model Invitation {
  id              String       @id @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  email           String
  proposedRoleIds String[]     @map("proposed_role_ids") @db.Uuid
  tokenHash       String       @unique @map("token_hash")
  /// pending | accepted | cancelled | expired
  status          String       @default("pending")
  invitedBy       String       @map("invited_by") @db.Uuid
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(6)
  lastSentAt      DateTime     @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  sendCount       Int          @default(1) @map("send_count")
  acceptedAt      DateTime?    @map("accepted_at") @db.Timestamptz(6)
  acceptedBy      String?      @map("accepted_by") @db.Uuid
  cancelledAt     DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?      @map("cancelled_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email, status])
  @@map("invitations")
}

/// Garment project (SS-02, I10). Lifecycle per SPEC-006 §7.5; status is independent of design status.
model Project {
  id               String       @id @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  displayId        String       @map("display_id")
  name             String
  description      String?
  /// ACTIVE | ON_HOLD | COMPLETED | ARCHIVED | DELETED (logical; erasure is I47)
  status           String       @default("ACTIVE")
  /// organization | restricted (restricted: members need a grant or project.manage_access)
  visibility       String       @default("organization")
  productCategory  String?      @map("product_category")
  season           String?
  brand            String?
  targetMarket     String?      @map("target_market")
  styleNumber      String?      @map("style_number")
  tags             String[]     @default([])
  /// Set by the designs module (I12); no FK until then.
  defaultDesignId  String?      @map("default_design_id") @db.Uuid
  /// Reason of the last hold / reopen / archive / delete.
  statusReason     String?      @map("status_reason")
  /// Source project of a duplicate (metadata only; approvals are never copied).
  duplicatedFromId String?      @map("duplicated_from_id") @db.Uuid
  version          Int          @default(1)
  createdBy        String?      @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(6)
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  designs          Design[]

  @@unique([organizationId, displayId])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  @@map("projects")
}

/// Every stored file (SS-11, I09). Originals and derived variants are separate rows; derived rows
/// point to their parent. Bytes live in object storage under `org/{orgId}/…` keys (AST-009).
model Asset {
  id               String       @id @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  displayId        String       @map("display_id")
  /// source_image | sketch | fabric_image | artwork | document | generated_image | svg | texture | model_3d | export | mask
  assetType        String       @map("asset_type")
  /// pending_upload | quarantined | ready | rejected
  status           String
  bucket           String
  storageKey       String       @map("storage_key")
  /// Sniffed from the bytes (null until uploaded).
  mediaType        String?      @map("media_type")
  sizeBytes        BigInt?      @map("size_bytes")
  checksumSha256   String?      @map("checksum_sha256")
  /// Declared by the client at upload start; verified by processing.
  declaredChecksum String?      @map("declared_checksum")
  declaredSize     BigInt?      @map("declared_size")
  dimensions       Json?
  metadata         Json         @default("{}")
  provenance       Json         @default("{}")
  fileName         String?      @map("file_name")
  isDerived        Boolean      @default(false) @map("is_derived")
  parentAssetId    String?      @map("parent_asset_id") @db.Uuid
  /// original | thumb_256 | preview_1024
  variant          String       @default("original")
  classification   String       @default("internal")
  projectId        String?      @map("project_id") @db.Uuid
  rejectionReason  String?      @map("rejection_reason")
  createdBy        String?      @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  readyAt          DateTime?    @map("ready_at") @db.Timestamptz(6)
  retentionUntil   DateTime?    @map("retention_until") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent           Asset?       @relation("AssetDerivatives", fields: [parentAssetId], references: [id], onDelete: Restrict)
  derivatives      Asset[]      @relation("AssetDerivatives")

  @@unique([organizationId, displayId])
  @@unique([bucket, storageKey])
  @@unique([parentAssetId, variant])
  @@index([organizationId, createdAt])
  @@index([organizationId, projectId])
  @@index([organizationId, status])
  @@map("assets")
}

/// A garment design inside a project (SS-03, I12). Its state lives in exactly one working copy
/// (mutable, optimistically versioned) and in immutable revisions (ADR-003, ADR-018).
model Design {
  id                     String           @id @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  projectId              String           @map("project_id") @db.Uuid
  displayId              String           @map("display_id")
  name                   String
  garmentType            String           @map("garment_type")
  garmentCategory        String?          @map("garment_category")
  /// DRAFT | IN_REVIEW | APPROVED | CHANGES_REQUESTED (review states are driven by I28)
  status                 String           @default("DRAFT")
  /// Latest committed revision (no FK: revisions reference designs; integrity is kept by the service).
  headRevisionId         String?          @map("head_revision_id") @db.Uuid
  /// Set only by approval (I28); never copied on duplication (FR-PRJ-007).
  approvedRevisionId     String?          @map("approved_revision_id") @db.Uuid
  /// Last used revision number (R001, R002 …).
  revisionCounter        Int              @default(0) @map("revision_counter")
  duplicatedFromDesignId String?          @map("duplicated_from_design_id") @db.Uuid
  createdBy              String?          @map("created_by") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?        @map("deleted_at") @db.Timestamptz(6)
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project                Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workingCopy            WorkingCopy?
  revisions              DesignRevision[]

  @@unique([organizationId, displayId])
  @@index([organizationId, projectId, updatedAt])
  @@map("designs")
}

/// The single mutable state of a design (ADR-018). `version` guards every write (API-002).
model WorkingCopy {
  id                     String          @id @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  designId               String          @unique @map("design_id") @db.Uuid
  /// Revision this state was derived from (the head after a commit, R after a restore).
  baseRevisionId         String?         @map("base_revision_id") @db.Uuid
  restoredFromRevisionId String?         @map("restored_from_revision_id") @db.Uuid
  /// GarmentDesignState (packages/garment-model)
  state                  Json
  schemaVersion          String          @map("schema_version")
  /// semanticHash(state) — compared with the head revision to know about uncommitted changes.
  semanticHash           String          @map("semantic_hash")
  hasUncommittedChanges  Boolean         @default(false) @map("has_uncommitted_changes")
  version                Int             @default(1)
  lastModifiedBy         String?         @map("last_modified_by") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  design                 Design          @relation(fields: [designId], references: [id], onDelete: Restrict)
  baseRevision           DesignRevision? @relation("WorkingCopyBase", fields: [baseRevisionId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([baseRevisionId])
  @@map("working_copies")
}

/// Immutable design revision (DSN-008, FR-PRJ-026). A trigger rejects every UPDATE and DELETE.
model DesignRevision {
  id                     String        @id @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  designId               String        @map("design_id") @db.Uuid
  displayId              String        @map("display_id")
  revisionNumber         Int           @map("revision_number")
  /// Reserved for branches (ADR-018: deferred); always null today.
  branchId               String?       @map("branch_id") @db.Uuid
  parentRevisionIds      String[]      @map("parent_revision_ids") @db.Uuid
  restoredFromRevisionId String?       @map("restored_from_revision_id") @db.Uuid
  /// Canonical JSON of the GarmentDesignState as committed (ADR-003).
  snapshot               Json
  /// sha256 of the canonical snapshot ("sha256:…").
  contentHash            String        @map("content_hash")
  semanticHash           String        @map("semantic_hash")
  schemaVersion          String        @map("schema_version")
  /// Pinned artifact revision ids used by the snapshot (FR-PRJ-028). Text until I13 defines them.
  artifactRevisionRefs   String[]      @map("artifact_revision_refs")
  /// Asset ids referenced by components (sources, renders…).
  sourceAssetRefs        String[]      @map("source_asset_refs")
  changeSummary          String        @map("change_summary")
  changeDiffSummary      Json          @map("change_diff_summary")
  validationSummary      Json          @map("validation_summary")
  /// Operations that produced this revision (I14).
  operationIds           String[]      @default([]) @map("operation_ids") @db.Uuid
  createdBy              String?       @map("created_by") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  design                 Design        @relation(fields: [designId], references: [id], onDelete: Restrict)
  workingCopies          WorkingCopy[] @relation("WorkingCopyBase")

  @@unique([designId, revisionNumber])
  @@unique([organizationId, displayId])
  @@index([organizationId])
  @@map("design_revisions")
}
