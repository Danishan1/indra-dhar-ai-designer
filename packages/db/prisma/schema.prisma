// AI Designer — Prisma schema (PostgreSQL).
//
// Conventions (docs/plan/02-conventions.md §7, 03-domain-model.md):
// - Models are PascalCase singular; tables snake_case plural via @@map; columns snake_case via @map.
// - Primary keys: uuid (UUIDv7 generated in the application, ADR-001).
// - Timestamps: timestamptz (@db.Timestamptz(6)), UTC.
// - Tenant tables carry organization_id (uuid, not null, indexed).
// - Immutable records (revisions, ledgers, audit) are protected by DB triggers in raw-SQL migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Records which plan iteration/schema baseline the database is at (informational).
model SchemaMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("schema_meta")
}

// ───────────────────────────── Platform primitives (I03) ─────────────────────────────

/// Per-scope counters for human-readable display ids (ADR-001), e.g. PRJ-000123.
/// scope_key = organization id, or "platform" for global sequences.
model IdSequence {
  scopeKey  String   @map("scope_key")
  prefix    String
  nextValue BigInt   @default(0) @map("next_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([scopeKey, prefix])
  @@map("id_sequences")
}

/// Append-only audit trail (SPEC-009 §15). UPDATE/DELETE are blocked by a trigger.
model AuditEvent {
  id             String   @id @db.Uuid
  eventType      String   @map("event_type")
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  organizationId String?  @map("organization_id") @db.Uuid
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  action         String
  outcome        String
  reasonCode     String?  @map("reason_code")
  requestId      String?  @map("request_id")
  correlationId  String?  @map("correlation_id")
  policyVersion  String?  @map("policy_version")
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([organizationId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([eventType, occurredAt])
  @@map("audit_events")
}

/// Transactional outbox (ADR-005): written in the same transaction as the state change.
model OutboxEvent {
  id             String    @id @db.Uuid
  type           String
  schemaVersion  Int       @map("schema_version")
  payload        Json
  organizationId String?   @map("organization_id") @db.Uuid
  actorType      String    @map("actor_type")
  actorId        String?   @map("actor_id")
  correlationId  String?   @map("correlation_id")
  causationId    String?   @map("causation_id")
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

/// Consumer de-duplication: one row per (consumer, event) that has been processed.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

/// HTTP Idempotency-Key records (docs/plan/01-architecture.md §4.4).
model IdempotencyKey {
  id             String   @id @db.Uuid
  principalKey   String   @map("principal_key")
  route          String
  key            String
  requestHash    String   @map("request_hash")
  status         String
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([principalKey, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Generic durable job record (ADR-023). BullMQ messages carry only the job id.
model Job {
  id             String       @id @db.Uuid
  displayId      String       @map("display_id")
  kind           String
  status         String
  organizationId String?      @map("organization_id") @db.Uuid
  payload        Json         @default("{}")
  result         Json?
  failure        Json?
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3) @map("max_attempts")
  correlationId  String?      @map("correlation_id")
  createdBy      String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  heartbeatAt    DateTime?    @map("heartbeat_at") @db.Timestamptz(6)
  attemptsLog    JobAttempt[]

  @@unique([organizationId, displayId])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("jobs")
}

model JobAttempt {
  id            String    @id @db.Uuid
  jobId         String    @map("job_id") @db.Uuid
  attemptNumber Int       @map("attempt_number")
  status        String
  workerId      String?   @map("worker_id")
  error         Json?
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@map("job_attempts")
}

// ---------------------------------------------------------------- identity (I05, ADR-006 Better Auth)
// Table/field names follow our conventions; Better Auth's logical models are mapped onto them in
// apps/api/src/modules/identity/auth.ts (user → User, session → Session, account →
// IdentityCredential, verification → VerificationToken).

model User {
  id               String               @id @db.Uuid
  email            String               @unique
  displayName      String               @map("display_name")
  emailVerified    Boolean              @default(false) @map("email_verified")
  image            String?
  /// pending_verification | active | suspended | locked | deletion_pending | deleted_or_anonymized (FR-SEC-004)
  status           String               @default("pending_verification")
  emailVerifiedAt  DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt      DateTime?            @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount Int                  @default(0) @map("failed_login_count")
  lockedUntil      DateTime?            @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions         Session[]
  credentials      IdentityCredential[]

  @@index([status])
  @@map("users")
}

/// Browser session. `token` is the opaque session id; the cookie carries it HMAC-signed with
/// BETTER_AUTH_SECRET, so a leaked table alone cannot be replayed (ADR-006).
model Session {
  id                String   @id @db.Uuid
  token             String   @unique
  userId            String   @map("user_id") @db.Uuid
  /// Idle expiry (sliding, refreshed at most once per SESSION_TOUCH_INTERVAL).
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  /// Absolute expiry; never extended.
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(6)
  authAssurance     String   @default("password") @map("auth_assurance")
  /// HMAC of the client IP (never the raw address).
  ipAddress         String?  @map("ip_hash")
  userAgent         String?  @map("user_agent_summary")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Login credentials. providerId 'credential' = password (argon2id hash in `password`); later
/// 'totp', 'passkey', OIDC providers (I08, backlog).
model IdentityCredential {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  password              String?   @map("password_hash")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("identity_credentials")
}

/// Single-use tokens (email verification, password reset). `identifier` is stored as a SHA-256
/// hash of "<purpose>:<token>" — the raw token exists only in the email (FR-SEC-012/015).
model VerificationToken {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([value])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------- organizations (I06, ADR-017)

/// Tenant boundary (FR-SEC-060/061). display_id ORG-000123 is platform-unique.
model Organization {
  id          String         @id @db.Uuid
  displayId   String         @unique @map("display_id")
  name        String
  slug        String         @unique
  /// active | suspended | deleted
  status      String         @default("active")
  /// Continuity rule (FR-SEC-079): at least one active owner at all times.
  ownerPolicy String         @default("at_least_one_owner") @map("owner_policy")
  settings    Json           @default("{}")
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaces  Workspace[]
  memberships Membership[]
  invitations Invitation[]

  @@map("organizations")
}

/// Optional sub-scope inside an organization (ADR-017). Schema + default workspace only; UI later.
model Workspace {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  status         String       @default("active")
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("workspaces")
}

/// System roles (placeholder catalog, I06); I07 adds permissions and org-defined roles.
/// Role = named set of permissions (SPEC-009 §11.3). System roles (organization_id NULL) are synced
/// from packages/contracts/src/roles.ts at API start / `pnpm db:seed`; custom roles (organization_id
/// set) arrive later with the same catalog and checks (FR-SEC-092).
model Role {
  id             String           @id @db.Uuid
  key            String
  name           String
  description    String           @default("")
  /// organization | workspace
  scopeType      String           @default("organization") @map("scope_type")
  isSystem       Boolean          @default(true) @map("is_system")
  /// NULL for system roles; the owning organization for custom roles.
  organizationId String?          @map("organization_id") @db.Uuid
  /// Can be given through role assignment (false for Owner: transfer only).
  assignable     Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships    MembershipRole[]
  permissions    RolePermission[]

  @@map("roles")
}

/// Mirror of the permission catalog (packages/contracts/src/permissions.ts) for reporting and
/// referential integrity. Keys are never renamed or reused (FR-SEC-084).
model Permission {
  key          String           @id
  resourceType String           @map("resource_type")
  action       String
  description  String
  isPlatform   Boolean          @default(false) @map("is_platform")
  sensitive    Boolean          @default(false)
  roles        RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Explicit resource-level share (FR-SEC-094…100), evaluated by the PDP after role permissions.
/// Creation endpoints arrive with shareable resources (projects I10, tech packs I43).
model ResourceGrant {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  resourceType   String    @map("resource_type")
  resourceId     String    @map("resource_id") @db.Uuid
  /// user | external (I43)
  recipientType  String    @map("recipient_type")
  recipientId    String    @map("recipient_id") @db.Uuid
  actions        String[]
  grantedBy      String    @map("granted_by") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, recipientType, recipientId])
  @@index([resourceType, resourceId])
  @@map("resource_grants")
}

/// Versioned organization security policy (defaults created with the org; used by I08/I28).
model SecurityPolicy {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  version        Int
  config         Json     @default("{}")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, version])
  @@map("security_policies")
}

/// One record per user–organization relationship (FR-SEC-067). Ended memberships are kept for
/// history (FR-SEC-071); re-joining creates a new row. At most one active/suspended row per pair.
model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  /// invited | active | suspended | revoked | expired
  status         String
  invitedBy      String?          @map("invited_by") @db.Uuid
  invitationId   String?          @map("invitation_id") @db.Uuid
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz(6)
  endReason      String?          @map("end_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]

  @@index([userId])
  @@index([organizationId, status])
  @@map("memberships")
}

model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  /// Workspace id for workspace-scoped grants (ADR-017, not used yet); NULL = whole organization.
  scopeId      String?    @map("scope_id") @db.Uuid
  grantedBy    String?    @map("granted_by") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

/// Org-scoped, single-use, expiring invitation (FR-SEC-072…077). Token stored as SHA-256 only.
model Invitation {
  id              String       @id @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  email           String
  proposedRoleIds String[]     @map("proposed_role_ids") @db.Uuid
  tokenHash       String       @unique @map("token_hash")
  /// pending | accepted | cancelled | expired
  status          String       @default("pending")
  invitedBy       String       @map("invited_by") @db.Uuid
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(6)
  lastSentAt      DateTime     @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  sendCount       Int          @default(1) @map("send_count")
  acceptedAt      DateTime?    @map("accepted_at") @db.Timestamptz(6)
  acceptedBy      String?      @map("accepted_by") @db.Uuid
  cancelledAt     DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?      @map("cancelled_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email, status])
  @@map("invitations")
}
