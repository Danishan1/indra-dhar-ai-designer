// AI Designer — Prisma schema (PostgreSQL).
//
// Conventions (docs/plan/02-conventions.md §7, 03-domain-model.md):
// - Models are PascalCase singular; tables snake_case plural via @@map; columns snake_case via @map.
// - Primary keys: uuid (UUIDv7 generated in the application, ADR-001).
// - Timestamps: timestamptz (@db.Timestamptz(6)), UTC.
// - Tenant tables carry organization_id (uuid, not null, indexed).
// - Immutable records (revisions, ledgers, audit) are protected by DB triggers in raw-SQL migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Records which plan iteration/schema baseline the database is at (informational).
model SchemaMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("schema_meta")
}

// ───────────────────────────── Platform primitives (I03) ─────────────────────────────

/// Per-scope counters for human-readable display ids (ADR-001), e.g. PRJ-000123.
/// scope_key = organization id, or "platform" for global sequences.
model IdSequence {
  scopeKey  String   @map("scope_key")
  prefix    String
  nextValue BigInt   @default(0) @map("next_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([scopeKey, prefix])
  @@map("id_sequences")
}

/// Append-only audit trail (SPEC-009 §15). UPDATE/DELETE are blocked by a trigger.
model AuditEvent {
  id             String   @id @db.Uuid
  eventType      String   @map("event_type")
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  organizationId String?  @map("organization_id") @db.Uuid
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  action         String
  outcome        String
  reasonCode     String?  @map("reason_code")
  requestId      String?  @map("request_id")
  correlationId  String?  @map("correlation_id")
  policyVersion  String?  @map("policy_version")
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([organizationId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([eventType, occurredAt])
  @@map("audit_events")
}

/// Transactional outbox (ADR-005): written in the same transaction as the state change.
model OutboxEvent {
  id             String    @id @db.Uuid
  type           String
  schemaVersion  Int       @map("schema_version")
  payload        Json
  organizationId String?   @map("organization_id") @db.Uuid
  actorType      String    @map("actor_type")
  actorId        String?   @map("actor_id")
  correlationId  String?   @map("correlation_id")
  causationId    String?   @map("causation_id")
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

/// Consumer de-duplication: one row per (consumer, event) that has been processed.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

/// HTTP Idempotency-Key records (docs/plan/01-architecture.md §4.4).
model IdempotencyKey {
  id             String   @id @db.Uuid
  principalKey   String   @map("principal_key")
  route          String
  key            String
  requestHash    String   @map("request_hash")
  status         String
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([principalKey, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Generic durable job record (ADR-023). BullMQ messages carry only the job id.
model Job {
  id             String       @id @db.Uuid
  displayId      String       @map("display_id")
  kind           String
  status         String
  organizationId String?      @map("organization_id") @db.Uuid
  payload        Json         @default("{}")
  result         Json?
  failure        Json?
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3) @map("max_attempts")
  correlationId  String?      @map("correlation_id")
  createdBy      String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  heartbeatAt    DateTime?    @map("heartbeat_at") @db.Timestamptz(6)
  attemptsLog    JobAttempt[]

  @@unique([organizationId, displayId])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("jobs")
}

model JobAttempt {
  id            String    @id @db.Uuid
  jobId         String    @map("job_id") @db.Uuid
  attemptNumber Int       @map("attempt_number")
  status        String
  workerId      String?   @map("worker_id")
  error         Json?
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@map("job_attempts")
}
