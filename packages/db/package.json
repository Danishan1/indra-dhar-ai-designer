{
  "name": "@ai-designer/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, seeds and the generated client shared by api and worker",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "clean": "rimraf dist coverage .turbo src/generated"
  },
  "dependencies": {
    "@ai-designer/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-designer/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
