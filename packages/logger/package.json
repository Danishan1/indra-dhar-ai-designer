{
  "name": "@ai-designer/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Node.js logging: redaction policy, console + rotating local log files (logs/)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "pino-roll": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-designer/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "rimraf": "6.1.3",
    "sonic-boom": "^4.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
