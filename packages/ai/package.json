{
  "name": "@ai-designer/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Provider-independent AI interface (structured multimodal output, image generation) with Gemini, OpenAI and fake adapters. Server-side only: keys never reach the browser.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-designer/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
