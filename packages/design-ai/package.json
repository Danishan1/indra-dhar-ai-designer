{
  "name": "@ai-designer/design-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI design analyzer and tech pack logic (pure): prompts and response schemas, component library matching, analysis → garment state, tech pack document and HTML",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@ai-designer/ai": "workspace:*",
    "@ai-designer/garment-model": "workspace:*",
    "@ai-designer/garment-render": "workspace:*",
    "@ai-designer/pattern-model": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-designer/config": "workspace:*",
    "eslint": "10.13.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
