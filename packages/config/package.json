{
  "name": "@ai-designer/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tooling configuration (TypeScript, ESLint, Prettier, Vitest)",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/nestjs.json": "./tsconfig/nestjs.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./prettier": {
      "types": "./prettier/index.d.ts",
      "default": "./prettier/index.js"
    },
    "./vitest": {
      "types": "./vitest/preset.d.ts",
      "default": "./vitest/preset.js"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3",
    "typescript": ">=5.8",
    "vitest": ">=4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
